<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Analyzer package: ships only analyzers/, never runtime assets. Marks the package so
         consumers get PrivateAssets="all" implicitly and no future dependency can leak. -->
    <DevelopmentDependency>true</DevelopmentDependency>
	<IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>

  <PropertyGroup>
	<!-- nuget -->
    <PackageId>Telani.SourceGenerator</PackageId>
	<PackageProjectUrl>https://github.com/telani-app/telani.sourcegenerator</PackageProjectUrl>
    <Authors>telani-Team</Authors>
    <Company>gb&amp;t Gebäudebestand und Technik GmbH</Company>
    <Product>Telani.SourceGenerator</Product>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<RepositoryUrl>https://github.com/telani-app/telani.sourcegenerator</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<IncludeSymbols>false</IncludeSymbols>
	<DebugType>Embedded</DebugType>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

    <PropertyGroup Condition="'$(CI)' == 'true'">
	    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

	<!--
      https://github.com/dotnet/roslyn/issues/52017#issuecomment-1046216200
      Ship the generator's own dependencies next to it in analyzers/dotnet/cs: Roslyn loads an
      analyzer from that folder and probes the same folder for what it needs. It does NOT resolve
      the package's nuspec dependencies, which is why a <dependency> entry cannot do this job.

      Pack RuntimeCopyLocalItems, not ResolvedCompileFileDefinitions. The latter also contains
      Roslyn itself and its whole closure (Microsoft.CodeAnalysis.*, System.Collections.Immutable,
      System.Reflection.Metadata, ...), which the compiler host already provides; shipping those
      risks binding against a different Roslyn than the host's. ExcludeAssets="runtime" on the
      Microsoft.CodeAnalysis.CSharp reference below keeps that closure out of this item, so the
      list stays correct on its own as dependencies change.
  -->
  <Target Name="AddGenerationTimeReferences" AfterTargets="ResolvePackageDependenciesForBuild">
    <ItemGroup>
      <None Include="@(RuntimeCopyLocalItems)" Pack="true" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- netstandard2.0 has no in-box System.HashCode, so the generator needs this at compile
         time. PrivateAssets keeps it out of the nuspec dependencies: without it the package
         flows into every consuming app's output, and a NativeAOT app cannot execute the IL.
         The DLL still reaches the generator at run time via AddGenerationTimeReferences above,
         which packs it into analyzers/dotnet/cs. -->
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" ExcludeAssets="runtime" />
	<PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />
	<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>
</Project>
