<Project Sdk="MSTest.Sdk/4.4.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <MSTestAnalysisMode>All</MSTestAnalysisMode>
    <IsPackable>false</IsPackable>

    <!-- Emit GitHub Actions workflow commands (collapsible per-assembly log groups, failure and
         skip annotations, and a job summary) when CI passes the report-gh switch. Off outside Actions.
         MSTest.Sdk only auto-enables this under TestingExtensionsProfile=AllMicrosoft, which would
         pull in extensions we do not want, so it is opted into per project; the SDK supplies the
         package version, including under central package management. -->
    <EnableMicrosoftTestingExtensionsGitHubActionsReport>true</EnableMicrosoftTestingExtensionsGitHubActionsReport>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drives the generators directly, the same way the compiler does. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- Reference assemblies for the compilations the generators run against, so the tests do not
         depend on whatever targeting packs happen to be installed on the machine. -->
    <PackageReference Include="Basic.Reference.Assemblies.Net80" Version="1.7.9" />
    <!-- The generator is compiled against this for System.HashCode, which netstandard2.0 lacks. It
         is PrivateAssets="all" there, so a ProjectReference does not bring it along; the package
         instead ships it next to the generator in analyzers/dotnet/cs. Reference it here so the
         tests load the generator the same way Roslyn does, or EquatableArray.GetHashCode throws
         FileNotFoundException at run time. -->
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- A plain library reference, not an Analyzer: the tests construct the generators themselves. -->
    <ProjectReference Include="..\..\src\Telani.SourceGenerator.csproj" />
  </ItemGroup>
</Project>
